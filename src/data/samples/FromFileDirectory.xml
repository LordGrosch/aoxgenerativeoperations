<!--

  ProcessFromFileDirectory.xml

	Itération sur un InputStreamAOX_ItemDataList
  
  Exécution de l'OperationAOX via le template InputStreamAOX
  
  <- InputStreamAOX_ItemDataList
  -> OutputStreamAOX_Text
  
    AOXOperationManager permet de surcharger les paramètres via la ligne de commande
    
    /param:"parameters.xml" /execute:"script.xml" /Site_Id:nnn /DbConnectionString:"xxxxxxxxx"
    
-->
<ObjectAOX Category="OperationAOX_OutputBinary" Type="OperationAOX_OutputBinary_OperationIterator">

  <Param Name="InputStreamAOX_ItemDataList" DataType="DynamicObjectAOX">
    <ObjectAOX Category="InputStreamAOX_ItemDataList" Type="InputStreamAOX_ItemDataList_Operation">
      <Param Name="OperationAOX" DataType="DynamicObjectAOX">

        <ObjectAOX Category="OperationAOX_OutputItemDataList" Type="OperationAOX_OutputItemDataList_Read_FileDirectory">

          <!--Input/Output de base-->

          <Param Name="InputStreamAOX" DataType="DynamicObjectAOX">
            <ObjectAOX Category="InputStreamAOX_None" Type="InputStreamAOX_None_ListInput">
              <Param Name="ListInput" DataType="DynamicObjectAOX">
                <ListObjectAOX>

                  <ObjectAOX Category="InputStreamAOX_None" Type="InputStreamAOX_None_FileDirectory">
                    <Param Name="DirectoryPath" DataType="String" Value="C:\Applications\MonProjet\Resources"></Param>
                    <Param Name="SearchPattern" DataType="String" Value="*.html"></Param>
                  </ObjectAOX>

                </ListObjectAOX>
              </Param>
            </ObjectAOX>
          </Param>

        </ObjectAOX>

      </Param>
    </ObjectAOX>
  </Param>

  <Param Name="InputStreamAOX" DataType="DynamicObjectAOX">
    <!-- <ObjectAOX Category="InputStreamAOX_Text" Type="InputStreamAOX_Text_File">
      <Param Name="FilePath" DataType="String" Value="%resource_folder%\Op_Template_UpdateMedia.xmlt" />
    </ObjectAOX>-->






    <ObjectAOX Category="OperationAOX_OutputBinary" Type="OperationAOX_OutputBinary_UpdateMedia">


      <Param Name="bUpdate" DataType="Boolean" Value="">
        <AttributeTranslation attribut='Value'>
          <GetVariable Name="Global.bUpdate"></GetVariable>
        </AttributeTranslation>
      </Param>

      <Param Name="bTestMode" DataType="Boolean" Value="">
        <AttributeTranslation attribut='Value'>
          <GetVariable Name="Global.bTestMode"></GetVariable>
        </AttributeTranslation>
      </Param>
      
      <Param Name="bInsert" DataType="Boolean" Value="">
        <AttributeTranslation attribut='Value'>
          <GetVariable Name="Global.bInsert"></GetVariable>
        </AttributeTranslation>
      </Param>

      <Param Name="FolderAppCode" DataType="String" Value="">
        <AttributeTranslation attribut='Value'>
          <GetVariable Name="Global.FolderAppCode"></GetVariable>
        </AttributeTranslation>
      </Param>

      <Param Name="InputStreamAOX" DataType="DynamicObjectAOX">
        <ObjectAOX Category="InputStreamAOX_Binary" Type="InputStreamAOX_Binary_File">
          <Param Name="FilePath" DataType="String" Value="">
            <AttributeTranslation attribut='Value'>
              <GetParameter Name="FilePath"></GetParameter>
            </AttributeTranslation>
          </Param>
        </ObjectAOX>
      </Param>

      <Param Name="OutputStreamAOX_Binary" DataType="DynamicObjectAOX">
        <ObjectAOX Category="OutputStreamAOX_Binary" Type="OutputStreamAOX_Binary_DBMedia">
          <Param Name="MediaAppCode" DataType="String" Value="">
            <AttributeTranslation attribut='Value'>
              <GetParameter Name="FileNameWithoutExtension"></GetParameter>
            </AttributeTranslation>
          </Param>
          <Param Name="FolderAppCode" DataType="String" Value="">
            <AttributeTranslation attribut='Value'>
              <GetParameter Name="FolderAppCode"></GetParameter>
            </AttributeTranslation>
          </Param>
        </ObjectAOX>
      </Param>

    </ObjectAOX>










  </Param>

  <Param Name="OutputStreamAOX_Result" DataType="DynamicObjectAOX">
    <ObjectAOX Category="OutputStreamAOX_Text" Type="OutputStreamAOX_Text_File">
      <Param Name="FilePath" DataType="String" Value="%resource_folder%\ProcessFromFileDirectory_Result_%timestamp%.txt" />
    </ObjectAOX>
  </Param>

</ObjectAOX>
